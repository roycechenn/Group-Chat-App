#include <string.h>
#include <unistd.h>
#include <sys/types.h>

#define BUF_SIZE 1024

struct clientInfo {
  int cfd;
  uint32_t ip;
  uint16_t port;
  char buf[BUF_SIZE];
  int buf_len;
  int is_done;
  int active;
};

int write_func(int fd, const char *buf, size_t len);
int writeTypeOne(int clientSize, struct clientInfo *clientInfo);
